      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(update-config)",
      "WebSearch",
      "WebFetch(domain:skillsmp.com)",
      "Bash(python3 *)",
      "Bash([ -d \"$base/skills\" ])",
      "Bash(claude plugin *)",
      "Bash(Out-Null)",
      "Bash(Write-Output \"done\")",
      "Bash(npm run *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git config *)",
      "Bash(git push *)",
      "Bash(netstat -ano)",
      "Bash(node dist/server.js)",
      "Bash(uuidgen)",
      "Bash(xargs -I{} cat /proc/{}/fd/1)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git rebase *)",
      "Bash(git rev-list *)",
      "Bash(npm install *)",
      "Bash(node -e \"const c = require\\('./ecosystem.config.js'\\); console.log\\(c.apps.map\\(a => a.name\\).join\\('\\\\n'\\)\\)\")",
      "Bash(node --experimental-vm-modules generate-runbook.mjs)",
      "Bash(npm init *)",
      "Bash(node generate-runbook.mjs)",
      "Bash(python -c \"import sys,json; d=json.load\\(sys.stdin\\); plugins=[p for p in d.get\\('plugins',[]\\) if 'reflect' in str\\(p\\) or 'capture' in str\\(p\\)]; print\\(json.dumps\\(plugins[:2], indent=2\\)\\)\")",
      "Bash(node *)",
      "Bash(Select-Object -First 30)",
      "Bash(git clone *)",
      "Bash(gh api *)",
      "WebFetch(domain:api.github.com)",
      "Bash(Select-Object Name)",
      "Bash(Remove-Item *)",
      "Bash(gh repo *)",
      "Bash(npm -v)",
      "Bash(docker --version)",
      "Bash(docker compose *)",
      "Bash(mkdir -p cafe-pos)",
      "Bash(mv cafe-pos-progress.md cafe-pos/cafe-pos-progress.md)",
      "Bash(python -c \"import json,sys; d=json.load\\(sys.stdin\\); p=d['enabledPlugins']; off=[k for k,v in p.items\\(\\) if not v]; on=[k for k,v in p.items\\(\\) if v]; print\\('VALID JSON'\\); print\\('ENABLED:',len\\(on\\)\\); print\\('DISABLED:',len\\(off\\)\\)\")",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth *)",
      "Bash(grep -rnE '\\([0-9]{1,3}\\\\.\\){3}[0-9]{1,3}' . --include='*.ps1' --include='*.cmd' --include='*.md')",
      "Bash(grep -rniE 'token|secret|password|passwd|pwd|apikey|api_key' . --include='*.ps1' --include='*.cmd' --include='*.md')",
      "Bash(grep -rniE 'TNI|corp|company|\\\\.local|\\\\.com|\\\\.net|http' . --include='*.ps1' --include='*.cmd' --include='*.md')",
      "Bash(find . -type f \\\\\\( -iname '*.json' -o -iname '*.cer' -o -iname '*.crt' -o -iname '*.msi' -o -iname '*.pdf' -o -iname '*.log' -o -iname '*.xml' -o -iname '*.pfx' -o -iname '*.key' \\\\\\))",
      "Bash(grep -nE '\\([0-9]{1,3}\\\\.\\){3}[0-9]{1,3}' README.md)",
      "Bash(git commit *)",
      "Bash(git ls-tree *)",
      "Bash(start *)",
      "Bash(New-Item -ItemType Directory -Path \"C:\\\\Temp\\\\rust-lp-tmp\\\\6-2-26\")",
      "Bash(Select-Object FullName)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r .tool_name > \"$HOME/.claude/current-tool.txt\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$HOME/.claude/current-tool.txt\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f \"$HOME/.claude/current-tool.txt\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/you/.claude/statusline-command.sh",
    "refreshInterval": 1
  },
